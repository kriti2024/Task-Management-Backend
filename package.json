{
  "name": "task-management-backend",
  "version": "1.0.0",
  "main": "app.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/app.js",
    "dev": "pnpm run \"/dev:/\"",
    "dev:tsc": "tsc --watch --preserveWatchOutput",
    "dev:node": "node --enable-source-maps --watch dist/src/app.js",
    "generate:prisma": "prisma generate --schema=src/prisma/schema.prisma",
    "migrate:dev": "prisma migrate dev --schema=src/prisma/schema.prisma"
  },
