  "type": "module",
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^6.15.0",
    "@prisma/client": "^6.15.0",
    "bcrypt": "^6.0.0",
    "express": "^5.1.0",
    "pg": "^8.16.3",
    "prisma": "^6.15.0",
    "zod": "^4.1.5"
  }
